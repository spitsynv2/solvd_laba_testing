<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="WebTests suite"
       verbose="1"
       parallel="methods"
       thread-count="4"
       data-provider-thread-count="4">

    <test name="Ebay + DataProvider + Crypto Tests"
          parallel="methods"
          thread-count="4">
        <classes>
            <class name="com.solvd.web.EbayWebDesktopTests">
