                    <include name="itemTitleEqualsTest"/>
                    <include name="itemTitleEqualsTest2"/>
                    <include name="itemTitleEqualsTest3"/>
                    <include name="itemTitleEqualsTest4"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>